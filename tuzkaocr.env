TUZKAOCR_DEVICE=cpu

TUZKAOCR_OCR_THREADS=4

TUZKAOCR_LINE_WORKERS=4

TUZKAOCR_PAGE_WORKERS=2

# CUDA only. Arena shrinkage is ON by default: it releases the block set the arena would
# otherwise retain per distinct input shape, which is what makes VRAM climb across mixed page
# sizes. Set to 0 only to reproduce the old behavior.
# TUZKAOCR_GPU_ARENA_SHRINK=0
#
# Cap on concurrent GPU inferences (0=unlimited). Unset is safe for shape-driven growth but not
# for concurrency: page_workers inferences share one arena. On a 16 GB card, 4 measured as the
# throughput knee (~2.8 GB peak) with page_workers=10. See bench/GPU_TUNING_AND_FIX.md.
# TUZKAOCR_GPU_CONCURRENCY=4

TUZKAOCR_HEIGHT_SCALE=1.0

TUZKAOCR_ADAPTIVE_DOWNSAMPLE=true

TUZKAOCR_CPU_MEM_ARENA=true

TUZKAOCR_ROLE_CLASSIFIER=false

TUZKAOCR_ROLE_MODEL=role-H5.onnx

TUZKAOCR_RESULTS_DIR=results

TUZKAOCR_MAX_JOB_AGE_HOURS=24

TUZKAOCR_MAX_UPLOAD_MB=256

TUZKAOCR_MAX_IMAGE_PIXELS=300000000

TUZKAOCR_MAX_QUEUE=16

TUZKAOCR_API_KEY=

TUZKAOCR_API_KEYS_FILE=

TUZKAOCR_SPOOL_DIR=
